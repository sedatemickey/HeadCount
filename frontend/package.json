{
  "name": "headcount-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "element-plus": "^2.11.0",
    "konva": "^9.3.22",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-konva": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.0.6"
  }
}
